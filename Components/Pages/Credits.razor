@page "/credits"

<PageTitle>Project Creators | DevPulse</PageTitle>

<main class="credits-page">
    <header class="credits-hero">
        <p class="eyebrow">Project credits</p>
        <h1>Meet Team 3 Devils.</h1>
        <p>DevPulse Version 1 was created and developed by Mr. Chonlapol Srichayech, with the full student team participating in the project presentation and guidance provided by the project advisor.</p>
    </header>

    <section class="credits-panel" aria-labelledby="creator-heading">
        <div class="section-heading">
            <div>
                <span class="section-number">01</span>
                <h2 id="creator-heading">Team 3 Devils</h2>
            </div>
            <span class="member-count">3 members</span>
        </div>

        <div class="student-grid">
            @foreach (var member in StudentCreators)
            {
                <article class="creator-card @(member.PhotoUrl is not null ? "featured-creator" : "supporting-creator")">
                    @if (member.PhotoUrl is not null)
                    {
                        <div class="creator-photo-frame">
                            <img class="creator-photo" src="@member.PhotoUrl" alt="@member.PhotoAlt" fetchpriority="high" />
                        </div>
                    }
                    else
                    {
                        <span class="creator-avatar" aria-hidden="true">@member.Initials</span>
                    }
                    <div class="creator-copy">
                        @if (member.PhotoUrl is not null)
                        {
                            <span class="lead-badge">Project creator</span>
                        }
                        <p class="creator-role">@member.Role</p>
                        @if (string.IsNullOrWhiteSpace(member.Name))
                        {
                            <span class="blank-name" aria-label="Name has not been added"></span>
                        }
                        else
                        {
                            <h3>@member.Name</h3>
                        }
                        @if (member.PhotoUrl is not null)
                        {
                            <p class="creator-summary">Designed, developed, tested, documented, and prepared DevPulse Version 1 for deployment.</p>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="advisor-panel" aria-labelledby="advisor-heading">
        <div class="advisor-mark" aria-hidden="true">A</div>
        <div class="advisor-copy">
            <p class="eyebrow">Project guidance</p>
            <h2 id="advisor-heading">Advisor</h2>
            @if (string.IsNullOrWhiteSpace(ProjectAdvisor.Name))
            {
                <span class="blank-name advisor-blank" aria-label="Advisor name has not been added"></span>
            }
            else
            {
                <h3>@ProjectAdvisor.Name</h3>
            }
            <p>Academic guidance, project review, and support throughout the development of DevPulse.</p>
        </div>
    </section>

    <aside class="credit-note">
        <span aria-hidden="true">✦</span>
        <p><strong>Created for Team 3 Devils.</strong> Development was completed by the project lead, with the student team contributing to the presentation.</p>
    </aside>
</main>

@code {
    // Edit the team names and roles below when the project membership changes.
    private static readonly Creator[] StudentCreators =
    [
        new("Project lead · Design, development, testing, and documentation", "Mr. Chonlapol Srichayech", "01", "/images/chonlapol-srichayech.jpg", "Mr. Chonlapol Srichayech holding a medal beside a WorldSkills Thailand flag"),
        new("Presentation team", "Miss Kanchanit Klanpram", "02", null, null),
        new("Presentation team", "Miss Natthachaporn Anekchaiyaporn", "03", null, null)
    ];

    private static readonly Creator ProjectAdvisor = new("Advisor", "Mr. Suppakit Kongthong", "A", null, null);

    private sealed record Creator(string Role, string Name, string Initials, string? PhotoUrl, string? PhotoAlt);
}
