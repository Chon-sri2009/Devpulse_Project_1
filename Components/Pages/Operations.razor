@page "/operations"
@using MiniProject_Everything_1.Services
@inject NetworkDiagnosticsService Network
@inject DiagnosticToolsService Tools
@inject OperationsSettings Settings
@rendermode InteractiveServer
@implements IAsyncDisposable
<PageTitle>Operations | DevPulse</PageTitle>
<div class="feature-page">
    <header class="feature-hero"><p class="eyebrow">Network and host operations</p><h1>Service operations</h1>
        <p>Run bounded checks against targets selected by the application owner.</p></header>
    @if (error is not null) { <p class="notice error" role="alert">@error</p> }
    <section class="feature-grid-wide">
        <article class="feature-card span-two"><h2>Service Watchlist</h2><p>HTTP and TCP availability across the configured allowlist.</p>
            <button class="action" disabled="@busy" @onclick="CheckWatchlist">Check all services</button>
            @if (watchlist is not null) { <div class="result-table">@foreach (var item in watchlist) { <div><strong>@item.Name</strong><span>@item.Kind</span><span class="@(item.Healthy ? "good" : "bad")">@item.Status</span><span>@item.LatencyMs ms</span></div> }</div> }
        </article>
        <article class="feature-card"><h2>Network Ping Matrix</h2><p>ICMP latency for approved hosts.</p>
            <button class="action" disabled="@busy" @onclick="PingHosts">Ping approved hosts</button>
            @if (pings is not null) { <div class="stack-results">@foreach (var item in pings) { <div><strong>@item.Host</strong><span class="@(item.Reachable ? "good" : "bad")">@item.Status · @item.LatencyMs ms</span></div> }</div> }
        </article>
        <article class="feature-card"><h2>DNS Inspector</h2><p>Resolve addresses without accepting arbitrary hosts.</p>
            <select class="form-select" @bind="selectedHost">@foreach (var host in Network.Hosts) { <option value="@host">@host</option> }</select>
            <button class="action" disabled="@busy" @onclick="ResolveDns">Resolve DNS</button>
            @if (dns is not null) { <div class="code-result"><strong>@dns.DurationMs ms</strong>@foreach (var address in dns.Addresses) { <code>@address</code> }@if (dns.Error is not null) { <span class="bad">@dns.Error</span> }</div> }
        </article>
        <article class="feature-card"><h2>TLS Certificate Monitor</h2><p>Inspect port 443 certificate identity and expiry.</p>
            <button class="action" disabled="@(busy || string.IsNullOrEmpty(selectedHost))" @onclick="InspectTls">Inspect @selectedHost</button>
            @if (tls is not null) { <div class="detail-list"><span>Subject <strong>@tls.Subject</strong></span><span>Expires <strong>@(tls.Expires?.ToString("u") ?? "Unavailable")</strong></span><span>Remaining <strong class="@(tls.Valid && tls.DaysRemaining > 14 ? "good" : "bad")">@tls.DaysRemaining days</strong></span>@if(tls.Error is not null){<span class="bad">@tls.Error</span>}</div> }
        </article>
        <article class="feature-card"><h2>Database Health</h2><p>TCP connectivity, with protocol PING for configured Redis targets.</p>
            @if (Settings.Databases.Length == 0) { <p class="muted">No database targets configured.</p> }
            else { <button class="action" disabled="@busy" @onclick="CheckDatabases">Check databases</button> }
            @if (databases is not null) { <div class="stack-results">@foreach (var item in databases) { <div><strong>@item.Name <small>@item.Kind</small></strong><span class="@(item.Healthy ? "good" : "bad")">@item.Status · @item.LatencyMs ms</span></div> }</div> }
        </article>
        <article class="feature-card span-two"><h2>Live Log Tailer</h2><p>Shows the final 200 lines of an owner-approved file and refreshes every two seconds.</p>
            @if (Tools.ApprovedLogs.Count == 0) { <p class="muted">No log files configured. Add paths under Operations:ApprovedLogFiles.</p> }
            else { <select class="form-select" @bind="selectedLog">@foreach(var file in Tools.ApprovedLogs){<option value="@file">@file</option>}</select>
                <button class="action" @onclick="ToggleTail">@(tailTask is null ? "Start tailing" : "Stop tailing")</button> }
            @if (log is not null) { <p class="muted">Read @log.ReadAt.LocalDateTime.ToLongTimeString() · @log.Length bytes</p>@if(log.Error is not null){<p class="bad">@log.Error</p>}else{<pre class="log-view">@string.Join(Environment.NewLine, log.Lines)</pre>} }
        </article>
    </section>
</div>
@code {
    private bool busy; private string? error;
    private string selectedHost = "", selectedLog = "";
    private IReadOnlyList<WatchResult>? watchlist; private IReadOnlyList<PingResult>? pings;
    private IReadOnlyList<DatabaseHealthResult>? databases; private DnsResult? dns; private TlsResult? tls; private LogSnapshot? log;
    private CancellationTokenSource? tailCancellation; private Task? tailTask;
    protected override void OnInitialized() { selectedHost = Network.Hosts.FirstOrDefault() ?? ""; selectedLog = Tools.ApprovedLogs.FirstOrDefault() ?? ""; }
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = null; try { await action(); } catch(Exception ex) when(ex is not OperationCanceledException){ error = ex.Message; } finally { busy = false; } }
    private Task CheckWatchlist() => Run(async () => watchlist = await Network.CheckWatchlistAsync(default));
    private Task PingHosts() => Run(async () => pings = await Network.PingAllAsync(default));
    private Task ResolveDns() => Run(async () => dns = await Network.ResolveAsync(selectedHost, default));
    private Task InspectTls() => Run(async () => tls = await Network.InspectTlsAsync(selectedHost, default));
    private Task CheckDatabases() => Run(async () => databases = await Network.CheckDatabasesAsync(default));
    private async Task ToggleTail() { if (tailTask is not null) { await tailCancellation!.CancelAsync(); await tailTask; tailCancellation.Dispose(); tailCancellation = null; tailTask = null; return; } tailCancellation = new(); tailTask = Tail(tailCancellation.Token); }
    private async Task Tail(CancellationToken ct) { try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2)); do { log = Tools.ReadLog(selectedLog); await InvokeAsync(StateHasChanged); } while(await timer.WaitForNextTickAsync(ct)); } catch(OperationCanceledException) when(ct.IsCancellationRequested){} }
    public async ValueTask DisposeAsync() { if(tailCancellation is not null){ await tailCancellation.CancelAsync(); if(tailTask is not null) await tailTask; tailCancellation.Dispose(); } }
}
