@page "/spotify"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using MiniProject_Everything_1.Services
@inject SpotifySettings Settings
@inject SpotifyPlayerService Player
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS
@inject ILogger<Spotify> Logger
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Spotify Player | DevPulse</PageTitle>
<div class="spotify-page">
    <section class="spotify-hero">
        <p class="eyebrow">Spotify integration</p>
        <h1>Your music, connected.</h1>
        <p>Control Spotify devices in near real time or play through this browser with Spotify Premium.</p>
    </section>
    @if (!Settings.IsConfigured)
    {
        <section class="spotify-card"><span class="spotify-mark" aria-hidden="true">♫</span>
            <div><h2>Spotify is not configured yet</h2><p>The app owner needs to connect a Spotify developer application. Your diagnostics dashboard remains available.</p></div>
        </section>
    }
    else
    {
        @if (LoginError == "login")
        {
            <p role="alert" class="error-message">Spotify sign-in was cancelled or could not finish. Try connecting again.</p>
        }
        <AuthorizeView>
            <Authorized Context="auth">
                <section class="spotify-card">
                    <span class="spotify-mark" aria-hidden="true">♫</span>
                    <div><p class="connection-label">Spotify connected</p><h2>Welcome, @auth.User.Identity?.Name</h2>
                        <p>Playback controls and browser audio require Spotify Premium.</p></div>
                    <form method="post" action="/spotify/logout" data-enhance="false">
                        <AntiforgeryToken />
                        <button class="spotify-button disconnect-button" type="submit">Disconnect</button>
                    </form>
                </section>

                <section class="browser-player-card" aria-live="polite">
                    <div class="browser-player-copy">
                        <span class="status-dot @(!browserPlayerEnabled ? "off" : string.IsNullOrEmpty(browserDeviceId) ? "connecting" : "ready")" aria-hidden="true"></span>
                        <div>
                            <p class="connection-label">Device-first playback</p>
                            <h2>@(browserPlayerEnabled ? browserStatus : "Your Spotify apps stay in control")</h2>
                            <p>@(browserPlayerEnabled
                                ? "Browser audio is available, but DevPulse will not select it unless you ask."
                                : "DevPulse controls the active Spotify app on your computer, iPhone, speaker, or other Connect device without taking over playback.")</p>
                        </div>
                    </div>
                    @if (!browserPlayerEnabled)
                    {
                        <button id="spotify-browser-enable" class="spotify-button secondary-button" disabled="@(busy || browserLoading)" @onclick="EnableBrowserPlayer">
                            @(browserLoading ? "Enabling…" : "Enable browser audio")
                        </button>
                    }
                    else
                    {
                        <button id="spotify-browser-activate" class="spotify-button connect-button"
                            disabled="@(busy || string.IsNullOrEmpty(browserDeviceId))" @onclick="UseBrowserPlayer">
                            Play in this browser
                        </button>
                    }
                    @if (browserError is not null) { <p role="alert" class="browser-error">@browserError</p> }
                </section>

                <section class="music-browser" aria-busy="@tracksLoading">
                    <div class="album-library-header">
                        <div><p class="connection-label">Spotify catalog and library</p><h2>Find and play a song</h2><p>Search Spotify, open your Liked Songs, or inspect the active playback queue.</p></div>
                    </div>
                    <div class="music-search">
                        <input class="form-control" maxlength="100" @bind="trackQuery" @bind:event="oninput" placeholder="Song, artist, album, or Spotify search filters" aria-label="Search Spotify songs" />
                        <button class="spotify-button connect-button" disabled="@(busy || tracksLoading || string.IsNullOrWhiteSpace(trackQuery))" @onclick="SearchTracks">Search songs</button>
                        <button class="spotify-button secondary-button" disabled="@(busy || tracksLoading)" @onclick="LoadLikedSongs">Liked Songs</button>
                        <button class="spotify-button secondary-button" disabled="@(busy || tracksLoading)" @onclick="LoadQueue">View queue</button>
                    </div>
                    @if (trackError is not null) { <p role="alert" class="error-message">@trackError</p> }
                    @if (trackMessage is not null) { <p role="status" class="album-message">@trackMessage</p> }
                    @if (tracksLoading) { <p role="status">Loading songs…</p> }
                    else if (trackPage is not null)
                    {
                        <div class="track-heading"><h3>@trackPage.Title</h3><span>@trackPage.Total songs</span></div>
                        @if (trackPage.Items.Count == 0) { <p>No playable songs were returned.</p> }
                        else
                        {
                            <div class="track-list">
                                @foreach (var track in trackPage.Items)
                                {
                                    <article class="track-row">
                                        @if (track.Image is not null) { <img src="@track.Image" alt="" width="54" height="54" loading="lazy" /> }
                                        else { <div class="track-placeholder" aria-hidden="true">♫</div> }
                                        <div class="track-copy"><strong>@track.Name @if(track.Explicit){<span class="explicit">E</span>}</strong><span>@track.Artists @if(!string.IsNullOrEmpty(track.Album)){<text> · @track.Album</text>}</span></div>
                                        <span class="track-time">@Duration(track.DurationMs)</span>
                                        @if (track.Link is not null) { <a class="spotify-link" href="@track.Link" target="_blank" rel="noopener" aria-label="Open @track.Name on Spotify">Spotify</a> }
                                        <button class="spotify-button connect-button" disabled="@(busy || !track.Playable)" @onclick='() => PlayTrack(track)'>Play</button>
                                        <button class="spotify-button secondary-button" disabled="@(busy || !CanControl || !track.Playable)" @onclick='() => QueueTrack(track)'>Queue</button>
                                    </article>
                                }
                            </div>
                        }
                        @if (trackSource != "queue")
                        {
                            <div class="album-pagination">
                                <button class="spotify-button secondary-button" disabled="@(!trackPage.HasPrevious || tracksLoading)" @onclick="PreviousTracks">Previous</button>
                                <span>Songs @(trackPage.Items.Count == 0 ? 0 : trackPage.Offset + 1)–@(trackPage.Offset + trackPage.Items.Count) of @trackPage.Total</span>
                                <button class="spotify-button secondary-button" disabled="@(!trackPage.HasNext || tracksLoading)" @onclick="NextTracks">Next</button>
                            </div>
                        }
                    }
                </section>

                <section class="album-library" aria-busy="@albumsLoading">
                    <div class="album-library-header">
                        <div>
                            <p class="connection-label">Your Spotify library</p>
                            <h2>Saved albums</h2>
                            <p>Albums you saved to Your Library. User-created collections appear under Playlists below.</p>
                        </div>
                        @if (albumPage is not null) { <span class="album-count">@albumPage.Total saved</span> }
                    </div>
                    @if (albumError is not null) { <p role="alert" class="error-message">@albumError</p> }
                    @if (albumMessage is not null) { <p role="status" class="album-message">@albumMessage</p> }
                    @if (albumsLoading && albumPage is null)
                    {
                        <p role="status">Loading your albums…</p>
                    }
                    else if (albumPage is { Items.Count: 0 })
                    {
                        <p>Your Spotify library does not contain any saved albums yet.</p>
                    }
                    else if (albumPage is not null)
                    {
                        <div class="album-grid">
                            @foreach (var album in albumPage.Items)
                            {
                                <article class="album-card">
                                    @if (album.Image is not null)
                                    {
                                        <img src="@album.Image" alt="Cover for @album.Name" width="160" height="160" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="album-placeholder" aria-hidden="true">♫</div>
                                    }
                                    <div class="album-details">
                                        <h3 title="@album.Name">@album.Name</h3>
                                        <p title="@album.Artists">@album.Artists</p>
                                        <div class="library-actions"><button class="spotify-button connect-button" disabled="@(busy || albumsLoading)"
                                            @onclick='() => PlayAlbum(album)'>Play</button><button class="spotify-button secondary-button" disabled="@(busy || tracksLoading)" @onclick='() => BrowseAlbum(album)'>Songs</button></div>
                                    </div>
                                </article>
                            }
                        </div>
                        <div class="album-pagination">
                            <button class="spotify-button secondary-button" disabled="@(!albumPage.HasPrevious || albumsLoading)"
                                @onclick="PreviousAlbums">Previous</button>
                            <span>Albums @(albumPage.Offset + 1)–@(albumPage.Offset + albumPage.Items.Count) of @albumPage.Total</span>
                            <button class="spotify-button secondary-button" disabled="@(!albumPage.HasNext || albumsLoading)"
                                @onclick="NextAlbums">Next</button>
                        </div>
                    }
                </section>

                <section class="album-library" aria-busy="@playlistsLoading">
                    <div class="album-library-header">
                        <div>
                            <p class="connection-label">Created and followed collections</p>
                            <h2>Your playlists</h2>
                            <p>Includes your public, private, collaborative, and followed playlists.</p>
                        </div>
                        @if (playlistPage is not null) { <span class="album-count">@playlistPage.Total playlists</span> }
                    </div>
                    @if (playlistError is not null) { <p role="alert" class="error-message">@playlistError</p> }
                    @if (playlistMessage is not null) { <p role="status" class="album-message">@playlistMessage</p> }
                    @if (playlistsLoading && playlistPage is null)
                    {
                        <p role="status">Loading your playlists…</p>
                    }
                    else if (playlistPage is { Items.Count: 0 })
                    {
                        <p>No playlists were returned. If you just granted access, disconnect and reconnect Spotify once.</p>
                    }
                    else if (playlistPage is not null)
                    {
                        <div class="album-grid">
                            @foreach (var playlist in playlistPage.Items)
                            {
                                <article class="album-card">
                                    @if (playlist.Image is not null)
                                    {
                                        <img src="@playlist.Image" alt="Cover for @playlist.Name" width="160" height="160" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="album-placeholder" aria-hidden="true">≡</div>
                                    }
                                    <div class="album-details">
                                        <h3 title="@playlist.Name">@playlist.Name</h3>
                                        <p title="Owned by @playlist.Owner">@playlist.Tracks tracks · @PlaylistKind(playlist)</p>
                                        <div class="library-actions"><button class="spotify-button connect-button" disabled="@(busy || playlistsLoading)"
                                            @onclick='() => PlayPlaylist(playlist)'>Play</button><button class="spotify-button secondary-button" disabled="@(busy || tracksLoading)" @onclick='() => BrowsePlaylist(playlist)'>Songs</button></div>
                                    </div>
                                </article>
                            }
                        </div>
                        <div class="album-pagination">
                            <button class="spotify-button secondary-button" disabled="@(!playlistPage.HasPrevious || playlistsLoading)"
                                @onclick="PreviousPlaylists">Previous</button>
                            <span>Playlists @(playlistPage.Offset + 1)–@(playlistPage.Offset + playlistPage.Items.Count) of @playlistPage.Total</span>
                            <button class="spotify-button secondary-button" disabled="@(!playlistPage.HasNext || playlistsLoading)"
                                @onclick="NextPlaylists">Next</button>
                        </div>
                    }
                </section>

                <section class="player-panel" aria-busy="@busy">
                    @if (error is not null) { <p role="alert" class="error-message">@error</p> }
                    @if (needsLogin)
                    {
                        <a href="/spotify/login" data-enhance-nav="false" class="spotify-button connect-button">Reconnect Spotify</a>
                    }
                    @if (!loaded) { <p role="status">Loading playback…</p> }
                    else if (playback is null) { <h2>Nothing playing yet</h2><p>Open Spotify on your computer or phone and start a track, then use DevPulse as the remote control.</p> }
                    else
                    {
                        <div class="now-playing">
                            @if (playback.Image is not null) { <img src="@playback.Image" alt="Album or episode artwork" width="144" height="144" /> }
                            <div><p class="connection-label">@(playback.Playing ? "Now playing" : "Paused")</p>
                                <h2>@playback.Title</h2><p>@playback.Creator</p>
                                @if (playback.Link is not null) { <a href="@playback.Link" target="_blank" rel="noopener">Listen on Spotify</a> }
                            </div>
                        </div>
                        @if (playback.DurationMs > 0)
                        {
                            <input class="track-progress" type="range" min="0" max="@playback.DurationMs" value="@CurrentProgress"
                                disabled="@(busy || !CanControl)" @onchange="SeekPlayback" aria-label="Seek through the current track" />
                            <p class="progress-label">@Duration(CurrentProgress) / @Duration(playback.DurationMs)</p>
                        }
                    }
                    <div class="spotify-actions">
                        <button class="spotify-button secondary-button" disabled="@(busy || !CanControl || Blocked("skipping_prev"))" @onclick='() => Command("previous")'>Previous</button>
                        <button class="spotify-button connect-button" disabled="@(busy || !CanControl || Blocked(playback?.Playing == true ? "pausing" : "resuming"))"
                            @onclick='() => Command(playback?.Playing == true ? "pause" : "play")'>@(playback?.Playing == true ? "Pause" : "Play")</button>
                        <button class="spotify-button secondary-button" disabled="@(busy || !CanControl || Blocked("skipping_next"))" @onclick='() => Command("next")'>Next</button>
                        <button class="spotify-button secondary-button" disabled="@(busy || !CanControl || Blocked("toggling_shuffle"))" @onclick="ToggleShuffle">Shuffle: @(playback?.Shuffle == true ? "On" : "Off")</button>
                        <label class="repeat-control">Repeat<select class="form-select" value="@(playback?.Repeat ?? "off")" @onchange="ChangeRepeat" disabled="@(busy || !CanControl || Blocked("toggling_repeat_context"))"><option value="off">Off</option><option value="context">Album/playlist</option><option value="track">Song</option></select></label>
                        <button class="spotify-button secondary-button" disabled="@busy" @onclick="Refresh">Refresh playback</button>
                        <a href="https://open.spotify.com/" target="_blank" rel="noopener" class="spotify-button secondary-button">Open Spotify</a>
                    </div>
                    <div class="device-controls">
                        <label for="spotify-device">Playback device</label>
                        <select id="spotify-device" class="form-select" value="@selectedDevice" @onchange="SelectDevice" disabled="@(busy || needsLogin)">
                            <option value="">Select a device</option>
                            @foreach (var device in devices)
                            {
                                <option value="@device.Id" disabled="@(device.Restricted || string.IsNullOrEmpty(device.Id))">@device.Name @(device.Active ? "(active)" : "") @(device.Restricted ? "(restricted)" : "")</option>
                            }
                        </select>
                        <button class="spotify-button secondary-button" disabled="@(busy || needsLogin || string.IsNullOrEmpty(selectedDevice) || Blocked("transferring_playback"))"
                            @onclick="TransferToSelectedDevice">Continue on this device</button>
                        @if (devices.Count == 0 && loaded) { <p>No devices found. Open a Spotify app or wait for the browser player to connect.</p> }
                        <label for="spotify-volume">Volume: @(volumeEdit ?? playback?.Device?.Volume ?? 0)%</label>
                        <input id="spotify-volume" type="range" min="0" max="100" value="@(volumeEdit ?? playback?.Device?.Volume ?? 0)"
                            @onchange="EditVolume" disabled="@(busy || !CanControl || playback?.Device?.SupportsVolume != true)" />
                        <button class="spotify-button secondary-button" disabled="@(busy || !CanControl || playback?.Device?.SupportsVolume != true)"
                            @onclick='() => Command("volume")'>Set volume</button>
                        @if (playback?.Device?.SupportsVolume == false) { <p>This device does not support remote volume changes.</p> }
                    </div>
                    <p class="refresh-note">Progress updates every second. Spotify state synchronizes every four seconds while this tab is visible.</p>
                    @if (updated is not null) { <p class="refresh-note">Last synchronized @updated.Value.ToLocalTime().ToString("HH:mm:ss")</p> }
                </section>
            </Authorized>
            <NotAuthorized>
                <section class="spotify-card"><span class="spotify-mark" aria-hidden="true">♫</span>
                    <div><h2>Connect your account</h2><p>Sign in to view your music, play in this browser, and control your Spotify devices.</p></div>
                    <a class="spotify-button connect-button" href="/spotify/login" data-enhance-nav="false">Connect Spotify</a>
                </section>
            </NotAuthorized>
        </AuthorizeView>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? LoginError { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private readonly SemaphoreSlim operationGate = new(1, 1);
    private Task? liveLoop;
    private System.Security.Claims.ClaimsPrincipal? user;
    private SpotifyPlayback? playback;
    private SpotifyAlbumPage? albumPage;
    private SpotifyPlaylistPage? playlistPage;
    private SpotifyTrackPage? trackPage;
    private SpotifyAlbum? browsedAlbum;
    private SpotifyPlaylist? browsedPlaylist;
    private IReadOnlyList<SpotifyDevice> devices = [];
    private IJSObjectReference? spotifyModule;
    private DotNetObjectReference<Spotify>? selfReference;
    private string? error, browserError, albumError, albumMessage, playlistError, playlistMessage, trackError, trackMessage;
    private string trackQuery = "", trackSource = "";
    private string browserStatus = "Browser audio is off";
    private string browserDeviceId = "";
    private string selectedDevice = "";
    private bool busy, loaded, needsLogin, pageVisible = true, albumsLoading, playlistsLoading, tracksLoading;
    private bool browserPlayerEnabled, browserLoading, deviceSelectionPinned;
    private int? volumeEdit, pendingSeek;
    private int progressAnchor;
    private DateTimeOffset progressAnchoredAt = DateTimeOffset.UtcNow;
    private DateTimeOffset nextSync = DateTimeOffset.MinValue;
    private DateTimeOffset lastDeviceSync = DateTimeOffset.MinValue;
    private DateTimeOffset? updated;
    private bool CanControl => !needsLogin && playback?.Device is { Restricted: false, Id.Length: > 0 };
    private bool Blocked(string action) => playback?.Disallowed.Contains(action) == true;
    private int CurrentProgress => playback is null ? 0 : Math.Clamp(progressAnchor +
        (playback.Playing ? (int)(DateTimeOffset.UtcNow - progressAnchoredAt).TotalMilliseconds : 0), 0, playback.DurationMs);
    private static string Duration(int ms) => TimeSpan.FromMilliseconds(Math.Max(0, ms)).ToString(@"m\:ss");
    private void EditVolume(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var n)) volumeEdit = Math.Clamp(n, 0, 100); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Settings.IsConfigured) return;
        user = (await Authentication.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true) return;
        await Sync(includeDevices: true, interactive: false);
        await LoadAlbums(0);
        await LoadPlaylists(0);
        liveLoop = LiveLoopAsync();
    }

    private async Task EnableBrowserPlayer()
    {
        if (browserPlayerEnabled || browserLoading) return;
        browserLoading = true;
        browserPlayerEnabled = true;
        browserStatus = "Connecting browser player…";
        browserError = null;
        StateHasChanged();
        await Task.Yield();
        await InitializeBrowserPlayer();
        browserLoading = false;
        StateHasChanged();
    }

    private async Task InitializeBrowserPlayer()
    {
        try
        {
            spotifyModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/spotify-player.js");
            selfReference = DotNetObjectReference.Create(this);
            await spotifyModule.InvokeAsync<bool>("initialize", selfReference);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            Logger.LogWarning("Spotify browser player initialization failed: {ExceptionType}", ex.GetType().Name);
            browserStatus = "Browser player unavailable";
            browserError = "The Spotify browser player could not start. Refresh the page or try another supported browser.";
            StateHasChanged();
        }
    }

    private async Task LiveLoopAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(lifetime.Token))
            {
                if (!pageVisible) continue;
                if (playback?.Playing == true) await InvokeAsync(StateHasChanged);
                if (!needsLogin && DateTimeOffset.UtcNow >= nextSync)
                    await InvokeAsync(() => Sync(includeDevices: false, interactive: false));
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private Task Refresh() => Sync(includeDevices: true, interactive: true);

    private async Task LoadAlbums(int offset)
    {
        if (albumsLoading || user is null || lifetime.IsCancellationRequested) return;
        albumsLoading = true;
        albumError = null;
        albumMessage = null;
        StateHasChanged();
        try
        {
            var result = await Player.GetSavedAlbumsAsync(user, Math.Max(0, offset), 12, lifetime.Token);
            if (!result.Success)
            {
                needsLogin = result.NeedsLogin;
                albumError = result.Status == 403
                    ? "Disconnect and reconnect Spotify once to grant access to your saved albums."
                    : result.Error;
                return;
            }
            albumPage = result.Data is { } data ? SpotifyPlayback.ParseSavedAlbums(data) : new([], 0, 12, 0);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning("Spotify album library failed: {ExceptionType}", ex.GetType().Name);
            albumError = "Your saved albums could not be loaded. Try again.";
        }
        finally
        {
            albumsLoading = false;
            if (!lifetime.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private Task PreviousAlbums() => albumPage is null
        ? Task.CompletedTask : LoadAlbums(Math.Max(0, albumPage.Offset - albumPage.Limit));
    private Task NextAlbums() => albumPage is null
        ? Task.CompletedTask : LoadAlbums(albumPage.Offset + albumPage.Limit);

    private async Task LoadPlaylists(int offset)
    {
        if (playlistsLoading || user is null || lifetime.IsCancellationRequested) return;
        playlistsLoading = true;
        playlistError = null;
        playlistMessage = null;
        StateHasChanged();
        try
        {
            var result = await Player.GetPlaylistsAsync(user, Math.Max(0, offset), 12, lifetime.Token);
            if (!result.Success)
            {
                needsLogin = result.NeedsLogin;
                playlistError = result.Status == 403
                    ? "Disconnect and reconnect Spotify once to grant private and collaborative playlist access."
                    : result.Error;
                return;
            }
            playlistPage = result.Data is { } data ? SpotifyPlayback.ParsePlaylists(data) : new([], 0, 12, 0);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning("Spotify playlist library failed: {ExceptionType}", ex.GetType().Name);
            playlistError = "Your playlists could not be loaded. Try again.";
        }
        finally
        {
            playlistsLoading = false;
            if (!lifetime.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private Task PreviousPlaylists() => playlistPage is null
        ? Task.CompletedTask : LoadPlaylists(Math.Max(0, playlistPage.Offset - playlistPage.Limit));
    private Task NextPlaylists() => playlistPage is null
        ? Task.CompletedTask : LoadPlaylists(playlistPage.Offset + playlistPage.Limit);

    private async Task PlayAlbum(SpotifyAlbum album)
    {
        var succeeded = false;
        await Run(async () =>
        {
            var target = string.IsNullOrWhiteSpace(selectedDevice) ? playback?.Device?.Id : selectedDevice;
            var result = await Player.PlayAlbumAsync(user!, album.Uri, target, lifetime.Token);
            if (!Accept(result)) return;
            succeeded = true;
        }, interactive: true);
        if (!succeeded) return;
        deviceSelectionPinned = false;
        albumMessage = $"Starting {album.Name}…";
        nextSync = DateTimeOffset.MinValue;
        StateHasChanged();
    }

    private async Task PlayPlaylist(SpotifyPlaylist playlist)
    {
        var succeeded = false;
        await Run(async () =>
        {
            var target = string.IsNullOrWhiteSpace(selectedDevice) ? playback?.Device?.Id : selectedDevice;
            var result = await Player.PlayPlaylistAsync(user!, playlist.Uri, target, lifetime.Token);
            if (!Accept(result)) return;
            succeeded = true;
        }, interactive: true);
        if (!succeeded) return;
        deviceSelectionPinned = false;
        playlistMessage = $"Starting {playlist.Name}…";
        nextSync = DateTimeOffset.MinValue;
        StateHasChanged();
    }

    private static string PlaylistKind(SpotifyPlaylist playlist) => playlist.Collaborative
        ? "Collaborative" : playlist.Public switch { true => "Public", false => "Private", _ => $"By {playlist.Owner}" };

    private Task SearchTracks() { trackSource = "search"; return LoadTracks(0); }
    private Task LoadLikedSongs() { trackSource = "liked"; return LoadTracks(0); }
    private Task BrowseAlbum(SpotifyAlbum album) { browsedAlbum = album; browsedPlaylist = null; trackSource = "album"; return LoadTracks(0); }
    private Task BrowsePlaylist(SpotifyPlaylist playlist) { browsedPlaylist = playlist; browsedAlbum = null; trackSource = "playlist"; return LoadTracks(0); }
    private Task PreviousTracks() => trackPage is null ? Task.CompletedTask : LoadTracks(Math.Max(0, trackPage.Offset - Math.Max(1, trackPage.Limit)));
    private Task NextTracks() => trackPage is null ? Task.CompletedTask : LoadTracks(trackPage.Offset + Math.Max(1, trackPage.Limit));

    private async Task LoadTracks(int offset)
    {
        if (tracksLoading || user is null) return;
        tracksLoading = true; trackError = null; trackMessage = null; StateHasChanged();
        try
        {
            SpotifyReply result = trackSource switch
            {
                "search" => await Player.SearchTracksAsync(user, trackQuery, offset, lifetime.Token),
                "liked" => await Player.GetSavedTracksAsync(user, offset, 12, lifetime.Token),
                "album" when browsedAlbum is not null => await Player.GetAlbumTracksAsync(user, browsedAlbum.Uri, offset, 20, lifetime.Token),
                "playlist" when browsedPlaylist is not null => await Player.GetPlaylistTracksAsync(user, browsedPlaylist.Uri, offset, 20, lifetime.Token),
                _ => new SpotifyReply(400, Error: "Choose music to browse first.")
            };
            if (!Accept(result)) { trackError = result.Error; return; }
            trackPage = result.Data is not { } data ? new([], 0, 10, 0, "Songs") : trackSource switch
            {
                "search" => SpotifyPlayback.ParseSearchTracks(data, trackQuery),
                "liked" => SpotifyPlayback.ParseSavedTracks(data),
                "album" => SpotifyPlayback.ParseAlbumTracks(data, browsedAlbum!),
                "playlist" => SpotifyPlayback.ParsePlaylistTracks(data, browsedPlaylist!),
                _ => new([], 0, 10, 0, "Songs")
            };
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogWarning("Spotify track browser failed: {ExceptionType}", ex.GetType().Name); trackError = "Songs could not be loaded. Try again."; }
        finally { tracksLoading = false; if (!lifetime.IsCancellationRequested) await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadQueue()
    {
        if (tracksLoading || user is null) return;
        trackSource = "queue"; tracksLoading = true; trackError = null; trackMessage = null; StateHasChanged();
        try
        {
            var result = await Player.GetQueueAsync(user, lifetime.Token);
            if (!Accept(result)) { trackError = result.Error; return; }
            var items = result.Data is { } data ? SpotifyPlayback.ParseQueue(data) : [];
            trackPage = new(items, 0, items.Count, items.Count, "Up next");
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogWarning("Spotify queue failed: {ExceptionType}", ex.GetType().Name); trackError = "The playback queue could not be loaded."; }
        finally { tracksLoading = false; if (!lifetime.IsCancellationRequested) await InvokeAsync(StateHasChanged); }
    }

    private async Task PlayTrack(SpotifyTrack track)
    {
        var succeeded = false;
        await Run(async () =>
        {
            var target = string.IsNullOrWhiteSpace(selectedDevice) ? playback?.Device?.Id : selectedDevice;
            var result = await Player.PlayTrackAsync(user!, track.Uri, trackPage?.ContextUri, target, lifetime.Token);
            if (!Accept(result)) return; succeeded = true;
        }, true);
        if (!succeeded) return;
        deviceSelectionPinned = false; trackMessage = $"Starting {track.Name}…"; nextSync = DateTimeOffset.MinValue; StateHasChanged();
    }

    private async Task QueueTrack(SpotifyTrack track)
    {
        var succeeded = false;
        await Run(async () =>
        {
            var result = await Player.AddToQueueAsync(user!, track.Uri, playback?.Device?.Id, lifetime.Token);
            if (!Accept(result)) return; succeeded = true;
        }, true);
        if (succeeded) { trackMessage = $"Added {track.Name} to the queue."; StateHasChanged(); }
    }

    private Task ToggleShuffle() => Command(playback?.Shuffle == true ? "shuffle-off" : "shuffle-on");
    private Task ChangeRepeat(ChangeEventArgs args)
    {
        var mode = args.Value?.ToString();
        return mode is "off" or "track" or "context" ? Command("repeat-" + mode) : Task.CompletedTask;
    }

    private Task Sync(bool includeDevices, bool interactive) => Run(async () =>
    {
        var current = await Player.GetPlaybackAsync(user!, lifetime.Token);
        if (!Accept(current)) return;
        SetPlayback(current.Data is { } data ? SpotifyPlayback.Parse(data) : null);

        if (includeDevices || DateTimeOffset.UtcNow - lastDeviceSync >= TimeSpan.FromSeconds(30))
        {
            var available = await Player.GetDevicesAsync(user!, lifetime.Token);
            if (!Accept(available)) return;
            devices = available.Data is { } list ? SpotifyPlayback.ParseDevices(list) : [];
            AddBrowserDevice();
            lastDeviceSync = DateTimeOffset.UtcNow;
        }

        var activeDevice = playback?.Device?.Id;
        if (string.IsNullOrEmpty(activeDevice) || !devices.Any(d => d.Id == activeDevice))
            activeDevice = devices.FirstOrDefault(d => d.Active)?.Id;
        if (!deviceSelectionPinned || !devices.Any(d => d.Id == selectedDevice))
            selectedDevice = activeDevice ?? devices.FirstOrDefault(d => !d.Restricted && d.Id != browserDeviceId)?.Id
                ?? devices.FirstOrDefault(d => !d.Restricted)?.Id ?? "";
        error = null;
        albumMessage = null;
        updated = DateTimeOffset.UtcNow;
        nextSync = DateTimeOffset.UtcNow.AddSeconds(4);
    }, interactive);

    private async Task Command(string command)
    {
        var succeeded = false;
        await Run(async () =>
        {
            var result = await Player.CommandAsync(user!, command,
                command is "transfer" or "transfer-play" ? selectedDevice : playback?.Device?.Id,
                command == "volume" ? volumeEdit ?? playback?.Device?.Volume ?? 0
                    : command == "seek" ? pendingSeek ?? CurrentProgress : null,
                lifetime.Token);
            if (!Accept(result)) return;
            succeeded = true;
        }, interactive: true);

        if (!succeeded) return;
        ApplyOptimistic(command);
        if (command is "transfer" or "transfer-play") deviceSelectionPinned = false;
        volumeEdit = null;
        pendingSeek = null;
        updated = null;
        nextSync = DateTimeOffset.MinValue;
        StateHasChanged();
    }

    private async Task UseBrowserPlayer()
    {
        if (string.IsNullOrEmpty(browserDeviceId) || spotifyModule is null) return;
        try { await spotifyModule.InvokeAsync<bool>("activate"); }
        catch (JSException)
        {
            browserError = "Your browser blocked audio activation. Select Play in this browser again.";
            return;
        }
        selectedDevice = browserDeviceId;
        deviceSelectionPinned = true;
        browserError = null;
        await Command("transfer-play");
    }

    private void SelectDevice(ChangeEventArgs args)
    {
        selectedDevice = args.Value?.ToString() ?? "";
        deviceSelectionPinned = !string.IsNullOrEmpty(selectedDevice);
    }

    private Task TransferToSelectedDevice() => Command(playback?.Playing == true ? "transfer-play" : "transfer");

    private async Task SeekPlayback(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value) || playback is null) return;
        pendingSeek = Math.Clamp(value, 0, playback.DurationMs);
        await Command("seek");
    }

    private void ApplyOptimistic(string command)
    {
        if (playback is null) return;
        var position = command == "seek" ? pendingSeek ?? CurrentProgress : CurrentProgress;
        playback = command switch
        {
            "play" => playback with { Playing = true, ProgressMs = position },
            "pause" => playback with { Playing = false, ProgressMs = position },
            "next" or "previous" => playback with { ProgressMs = 0 },
            "seek" => playback with { ProgressMs = position },
            "shuffle-on" => playback with { Shuffle = true },
            "shuffle-off" => playback with { Shuffle = false },
            "repeat-off" => playback with { Repeat = "off" },
            "repeat-track" => playback with { Repeat = "track" },
            "repeat-context" => playback with { Repeat = "context" },
            "volume" when playback.Device is not null => playback with
            {
                Device = playback.Device with { Volume = volumeEdit ?? playback.Device.Volume }
            },
            "transfer" or "transfer-play" when devices.FirstOrDefault(d => d.Id == selectedDevice) is { } target =>
                playback with { Device = target with { Active = true }, Playing = command == "transfer-play" || playback.Playing },
            _ => playback
        };
        if (command is "transfer" or "transfer-play")
            devices = devices.Select(d => d with { Active = d.Id == selectedDevice }).ToList();
        progressAnchor = playback.ProgressMs;
        progressAnchoredAt = DateTimeOffset.UtcNow;
    }

    private bool Accept(SpotifyReply result)
    {
        if (result.Success) return true;
        error = result.Error;
        needsLogin = result.NeedsLogin;
        if (result.RetryAfterSeconds > 0)
            nextSync = DateTimeOffset.UtcNow.AddSeconds(result.RetryAfterSeconds);
        return false;
    }

    private void SetPlayback(SpotifyPlayback? value)
    {
        playback = value;
        progressAnchor = value?.ProgressMs ?? 0;
        progressAnchoredAt = DateTimeOffset.UtcNow;
    }

    private void AddBrowserDevice()
    {
        if (string.IsNullOrEmpty(browserDeviceId) || devices.Any(d => d.Id == browserDeviceId)) return;
        devices = devices.Append(new SpotifyDevice(browserDeviceId, "DevPulse Web Player", false, false, true, 50)).ToList();
    }

    private async Task Run(Func<Task> action, bool interactive)
    {
        var entered = false;
        try
        {
            if (interactive)
            {
                busy = true;
                await operationGate.WaitAsync(lifetime.Token);
                entered = true;
                error = null;
            }
            else
            {
                entered = await operationGate.WaitAsync(0, lifetime.Token);
                if (!entered) return;
            }
            await action();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning("Spotify UI operation failed: {ExceptionType}", ex.GetType().Name);
            error = "Could not complete the request. Please try again.";
        }
        finally
        {
            loaded = true;
            if (entered) operationGate.Release();
            if (interactive) busy = false;
            if (!lifetime.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task OnBrowserPlayerReady(string deviceId) => InvokeAsync(() =>
    {
        browserDeviceId = deviceId;
        browserStatus = "Browser player ready";
        browserError = null;
        AddBrowserDevice();
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnBrowserPlayerNotReady(string _) => InvokeAsync(() =>
    {
        browserDeviceId = "";
        browserStatus = "Browser player disconnected";
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnBrowserPlayerStateChanged(BrowserPlaybackUpdate? state) => InvokeAsync(() =>
    {
        if (state is null || string.IsNullOrEmpty(browserDeviceId)) return;
        var image = SafeSpotifyImage(state.Image);
        var link = playback?.Title == state.Title ? playback.Link : null;
        var volume = playback?.Device?.Id == browserDeviceId ? playback.Device.Volume : 50;
        SetPlayback(new SpotifyPlayback(state.Title, state.Creator, image, link, !state.Paused,
            state.Position, state.Duration, new SpotifyDevice(browserDeviceId, "DevPulse Web Player", true, false, true, volume),
            state.Disallowed.ToHashSet(StringComparer.Ordinal), playback?.Shuffle ?? false, playback?.Repeat ?? "off"));
        if (!deviceSelectionPinned) selectedDevice = browserDeviceId;
        devices = devices.Select(d => d with { Active = d.Id == browserDeviceId }).ToList();
        AddBrowserDevice();
        updated = DateTimeOffset.UtcNow;
        nextSync = DateTimeOffset.UtcNow.AddSeconds(4);
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnBrowserPlayerError(BrowserPlayerError playerError) => InvokeAsync(() =>
    {
        browserStatus = playerError.Kind switch
        {
            "authentication" => "Reconnect required",
            "account" => "Spotify Premium required",
            "autoplay" => "Waiting for your click",
            _ => "Browser player unavailable"
        };
        browserError = playerError.Kind switch
        {
            "authentication" => "Disconnect and reconnect Spotify to grant the browser playback permission.",
            "account" => "Spotify reports that this account cannot use browser playback. Confirm that this signed-in account has Premium.",
            "initialization" => "This browser could not initialize protected Spotify audio. Try current Chrome, Edge, Firefox, or Safari.",
            "autoplay" => "Your browser blocked automatic audio. Select Play in this browser again.",
            _ => "Spotify browser playback stopped. Refresh the page and try again."
        };
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnSpotifyVisibilityChanged(bool visible) => InvokeAsync(async () =>
    {
        pageVisible = visible;
        if (visible && !needsLogin)
        {
            nextSync = DateTimeOffset.MinValue;
            await Sync(includeDevices: false, interactive: false);
        }
    });

    private static string? SafeSpotifyImage(string? value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme == "https" && uri.Host == "i.scdn.co" ? value : null;

    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync();
        if (liveLoop is not null) await liveLoop;
        if (spotifyModule is not null)
        {
            try { await spotifyModule.InvokeVoidAsync("disconnect"); }
            catch (JSDisconnectedException) { }
            await spotifyModule.DisposeAsync();
        }
        selfReference?.Dispose();
        operationGate.Dispose();
        lifetime.Dispose();
    }

    public sealed class BrowserPlaybackUpdate
    {
        public bool Paused { get; set; }
        public int Position { get; set; }
        public int Duration { get; set; }
        public string Title { get; set; } = "Nothing playing";
        public string Creator { get; set; } = "";
        public string? Image { get; set; }
        public string Uri { get; set; } = "";
        public string[] Disallowed { get; set; } = [];
    }

    public sealed class BrowserPlayerError
    {
        public string Kind { get; set; } = "playback";
        public string Message { get; set; } = "";
    }
}
